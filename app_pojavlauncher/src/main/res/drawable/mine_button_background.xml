<?xml version="1.0" encoding="utf-8" ?>
<!-- JAVA CRAFT X: botão JOGAR com gradiente roxo elétrico → azul neon e borda ciano -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#3A2A55" />
            <stroke android:width="1dp" android:color="#334A5A7A" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient android:angle="0" android:startColor="#5A12B8" android:endColor="#1E47B8" />
            <stroke android:width="2dp" android:color="#00E5FF" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient android:angle="0" android:startColor="#8B2CFF" android:endColor="#2F6BFF" />
            <stroke android:width="3dp" android:color="#00E5FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient android:angle="0" android:startColor="#8B2CFF" android:endColor="#2F6BFF" />
            <stroke android:width="1dp" android:color="#8000E5FF" />
        </shape>
    </item>
</selector>
