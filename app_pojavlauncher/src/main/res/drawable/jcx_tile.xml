<?xml version="1.0" encoding="utf-8"?>
<!-- Tile do dashboard JAVA CRAFT X: vidro grafite, borda roxa; pressionado acende em ciano -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="120">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient android:angle="315" android:startColor="#2A1E3F" android:endColor="#14203A" />
            <stroke android:width="1.5dp" android:color="#00E5FF" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient android:angle="315" android:startColor="#221833" android:endColor="#121A2E" />
            <stroke android:width="2dp" android:color="#00E5FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient android:angle="315" android:startColor="#1A1428" android:endColor="#0E1220" />
            <stroke android:width="1dp" android:color="#408B2CFF" />
        </shape>
    </item>
</selector>
